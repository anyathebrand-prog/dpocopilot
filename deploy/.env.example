# One file per DPCO install. Copy to .env and fill in. Generate secrets with: openssl rand -hex 24

# The DPCO's subdomain; its DNS A record must point at this server before first start.
DOMAIN=compliance.examplefirm.ng
BRAND_NAME=Example Privacy Partners
# Put their logo in deploy/brand/logo.png (light logo, shown on navy).
BRAND_LOGO=/brand/logo.png

POSTGRES_PASSWORD=
# Used once, at handover, to create the firm: https://DOMAIN/sign-up?token=SETUP_TOKEN
SETUP_TOKEN=
CRON_SECRET=

# Optional (see the main README): AI drafting endpoint.
# AI_BASE_URL=
# AI_MODEL=
# AI_API_KEY=
