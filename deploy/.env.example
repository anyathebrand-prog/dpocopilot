# One file per DPCO install. Copy to .env and fill in. Generate secrets with: openssl rand -hex 24

# The DPCO's subdomain; its DNS A record must point at this server before first start.
DOMAIN=compliance.examplefirm.ng
BRAND_NAME=Example Privacy Partners
# Put their logo in deploy/brand/logo.png (light logo, shown on navy).
BRAND_LOGO=/brand/logo.png

POSTGRES_PASSWORD=
# Used once, at handover, to create the firm: https://DOMAIN/sign-up?token=SETUP_TOKEN
SETUP_TOKEN=
CRON_SECRET=

# Optional (see the main README): AI drafting endpoint.
# AI_BASE_URL=
# AI_MODEL=
# AI_API_KEY=

# First start only: creates the platform Secretary account. Password 14+ characters (openssl rand -base64 18).
# Remove both lines after the first start; the account stays. Never set DEV_SKIP_MFA on a live server.
SECRETARY_EMAIL=
SECRETARY_PASSWORD=

# Country of this install: currency, VAT, time zone and statutory clock (lib/country.ts). Supported: NG (default).
COUNTRY=NG

# Optional: CloudVantage object storage (lib/bucket.ts) for images and PDFs; other files stay on the server disk.
# The app generates and refreshes its own access token from this account login. Use a PRIVATE bucket.
# Check with: node --env-file=.env scripts/cloudvantage-check.ts   Files already on disk stay there.
# CLOUDVANTAGE_EMAIL=
# CLOUDVANTAGE_PASSWORD=
# BUCKET_PROJECT_ID=
# BUCKET_NAME=

# Email through Resend (lib/email.ts). Without these, emails are only recorded and logged.
# Verify your domain in Resend (add its DNS records) before sending. EMAIL_FROM must use that domain.
# RESEND_API_KEY=
# EMAIL_FROM=DPO Copilot <no-reply@yourdomain.ng>
